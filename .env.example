# 复制为 .env 并填写真实值
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# MySQL（任务书硬性要求；Docker Compose 默认如下）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=legal
MYSQL_PASSWORD=legal_pass
MYSQL_DATABASE=legal_rag

# 向量后端：local=开发自研/FAISS 文件；qdrant=Compose 服务
VECTOR_BACKEND=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=legal_chunks

# 知识库原始数据目录
KB_SOURCE_DIR=C:\Users\64517\Desktop\法律

# 向量库持久化目录
VECTOR_STORE_DIR=./data/vectorstore

# 检索参数
RETRIEVE_TOP_K=6
CHUNK_SIZE=600
CHUNK_OVERLAP=80
MIN_SCORE=0.30
MAX_HISTORY_ROUNDS=12

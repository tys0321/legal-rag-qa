          "key": "lawyer_name",
          "label": "承办律师",
          "type": "text",
          "required": true
        },
        {
          "key": "matter",
          "label": "事由摘要",
          "type": "text",
          "required": false,
          "placeholder": "如：拖欠货款事宜"
        },
        {
          "key": "facts",
          "label": "委托人陈述的基本事实",

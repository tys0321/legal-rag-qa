          "required": false,
          "placeholder": "姓名，××律师事务所律师"
        },
        {
          "key": "defendant_name",
          "label": "被告姓名/名称",
          "type": "text",
          "required": true
        },
        {
          "key": "defendant_gender",
          "label": "被告性别（自然人）",
          "type": "text",
          "required": false
        },
        {
          "key": "defendant_job",
          "label": "被告工作单位/职务（自然人）",
          "type": "text",
          "required": false
        },
        {
          "key": "defendant_address",
          "label": "被告住所地",
          "type": "text",
          "required": true
        },
        {
          "key": "defendant_phone",
          "label": "被告联系方式（如知悉）",
          "type": "text",
          "required": false,
          "placeholder": "11位手机号"
        },
        {
          "key": "claims",
          "label": "诉讼请求",
          "type": "textarea",
          "required": true,
          "placeholder": "分项列明，须具体可执行。例：一、……；二、本案诉讼费用由被告负担。"
        },
        {
          "key": "facts",
          "label": "事实和理由",
          "type": "textarea",
          "required": true,
          "placeholder": "先写纠纷经过（时间地点人物起因经过结果），再写法律依据。"
        },
        {
          "key": "evidence",
          "label": "证据和证据来源，证人姓名和住所",
          "type": "textarea",
          "required": false,
          "placeholder": "1.……；2.……"
        },
        {
          "key": "copies",
          "label": "起诉状副本份数",
          "type": "text",
          "required": false,
          "placeholder": "按被告人数，如：1"
        },
        {
          "key": "date",
          "label": "落款日期",
          "type": "text",
          "required": false,
          "placeholder": "××××年××月××日"
        }
      ],
      "body": "# 民事起诉状\n\n> {{watermark}}\n\n**原告**：{{plaintiff_name}}，{{plaintiff_gender}}，{{plaintiff_birth}}生，{{plaintiff_nation}}，{{plaintiff_job}}，住{{plaintiff_address}}。身份证号：{{plaintiff_id}}。联系方式：{{plaintiff_phone}}。\n\n**委托诉讼代理人**：{{agent}}\n\n**被告**：{{defendant_name}}，{{defendant_gender}}，{{defendant_job}}，住{{defendant_address}}。联系方式：{{defendant_phone}}。\n\n**诉讼请求：**\n\n{{claims}}\n\n**事实和理由：**\n\n{{facts}}\n\n**证据和证据来源，证人姓名和住所：**\n\n{{evidence}}\n\n此致  \n**{{court}}**\n\n附：本起诉状副本{{copies}}份\n\n起诉人（签名）：{{plaintiff_name}}  \n{{date}}\n\n---\n{{disclaimer}}\n",
      "audiences": [
        "user",
        "lawyer",
        "judge",
        "prosecutor"
      ]

    {
      "id": "divorce_agreement",
      "name": "离婚协议书",
      "category": "婚姻家事",
      "description": "结构参考民政部门《离婚协议书》参考样板（自愿离婚、子女、财产、债务）。",
      "fields": [
        {
          "key": "party_a",
